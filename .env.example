# App Metadata
POCKETBASE_META_APP_NAME="MiForm"
POCKETBASE_META_APP_URL="http://localhost:8090"
POCKETBASE_META_SENDER_NAME="MiForm Notifications"
POCKETBASE_META_SENDER_EMAIL="noreply@example.com"

# SMTP Configuration (Required for notifications)
POCKETBASE_SMTP_HOST="smtp.example.com"
POCKETBASE_SMTP_PORT="587"
POCKETBASE_SMTP_USERNAME="smtp-user"
POCKETBASE_SMTP_PASSWORD="smtp-password"
POCKETBASE_SMTP_TLS="true" # "true", "false", or leave empty

# Initial Superuser Account (Auto-created on first run)
POCKETBASE_SUPERUSER_EMAIL="admin@example.com"
POCKETBASE_SUPERUSER_PASSWORD="ChangeMeToAStrongPassword123!"

# Cloudflare Turnstile CAPTCHA (Optional - fallback default secret key for forms with turnstile_enabled=true)
# TURNSTILE_SECRET_KEY="0x4AAAAAA..."
